{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeMender Analysis Agent",
          "rules": [
            {
              "id": "CM-INJ-001",
              "name": "SQL injection via string-built query",
              "shortDescription": {
                "text": "SQL injection via string-built query"
              },
              "fullDescription": {
                "text": "User-influenced data is concatenated/interpolated into a SQL statement, allowing query manipulation."
              },
              "help": {
                "text": "Use parameterised queries / prepared statements; never build SQL with string formatting."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-89",
                  "A03:2021 Injection"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "CM-DES-001",
              "name": "Insecure deserialisation",
              "shortDescription": {
                "text": "Insecure deserialisation"
              },
              "fullDescription": {
                "text": "Deserialising untrusted bytes can instantiate arbitrary objects and lead to remote code execution."
              },
              "help": {
                "text": "Use JSON or yaml.safe_load; for Java apply ObjectInputFilter allow-lists."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-502",
                  "A08:2021 Software and Data Integrity Failures"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "CM-INJ-002",
              "name": "OS command injection",
              "shortDescription": {
                "text": "OS command injection"
              },
              "fullDescription": {
                "text": "A shell command is built from dynamic input, enabling arbitrary command execution."
              },
              "help": {
                "text": "Pass arguments as a list with shell=False (or execFile), validate against an allow-list."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-78",
                  "A03:2021 Injection"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "CM-MEM-001",
              "name": "Unbounded string copy (buffer overflow)",
              "shortDescription": {
                "text": "Unbounded string copy (buffer overflow)"
              },
              "fullDescription": {
                "text": "Unbounded libc copies write past the destination buffer when input exceeds its size."
              },
              "help": {
                "text": "Use bounded variants (snprintf, strlcpy) with explicit sizes or -fbounds-safety annotations."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-120",
                  "A06:2021 Vulnerable and Outdated Components"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "CM-SEC-001",
              "name": "Hard-coded credential / API key",
              "shortDescription": {
                "text": "Hard-coded credential / API key"
              },
              "fullDescription": {
                "text": "A secret is embedded in source and will leak via version control, logs and build artifacts."
              },
              "help": {
                "text": "Rotate the secret immediately; load from Secret Manager / environment at runtime."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-798",
                  "A07:2021 Identification and Authentication Failures"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CM-CRY-002",
              "name": "Weak cipher / ECB mode",
              "shortDescription": {
                "text": "Weak cipher / ECB mode"
              },
              "fullDescription": {
                "text": "Deprecated or structurally weak encryption leaks plaintext patterns."
              },
              "help": {
                "text": "Use AES-GCM or ChaCha20-Poly1305 with unique nonces from a KMS-managed key."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-327",
                  "A02:2021 Cryptographic Failures"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CM-XSS-001",
              "name": "Cross-site scripting (unsafe HTML sink)",
              "shortDescription": {
                "text": "Cross-site scripting (unsafe HTML sink)"
              },
              "fullDescription": {
                "text": "Untrusted data reaches an HTML sink without contextual output encoding."
              },
              "help": {
                "text": "Use textContent / auto-escaping templates and sanitise rich content with an allow-list sanitiser."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-79",
                  "A03:2021 Injection"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CM-PATH-001",
              "name": "Path traversal in file access",
              "shortDescription": {
                "text": "Path traversal in file access"
              },
              "fullDescription": {
                "text": "A file path is derived from request input without canonicalisation or base-directory checks."
              },
              "help": {
                "text": "Resolve the path, verify it stays under an allowed base directory, and use an ID-to-file mapping."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-22",
                  "A01:2021 Broken Access Control"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CM-NET-001",
              "name": "TLS certificate verification disabled",
              "shortDescription": {
                "text": "TLS certificate verification disabled"
              },
              "fullDescription": {
                "text": "Disabling certificate validation permits man-in-the-middle interception."
              },
              "help": {
                "text": "Remove the override and trust a proper CA bundle."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-295",
                  "A07:2021 Identification and Authentication Failures"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CM-NET-002",
              "name": "Server-side request forgery (SSRF)",
              "shortDescription": {
                "text": "Server-side request forgery (SSRF)"
              },
              "fullDescription": {
                "text": "The server fetches a URL controlled by the caller and can be pointed at internal services or metadata endpoints."
              },
              "help": {
                "text": "Validate scheme/host against an allow-list and block link-local/private ranges."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-918",
                  "A10:2021 Server-Side Request Forgery"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CM-MEM-002",
              "name": "Format-string vulnerability",
              "shortDescription": {
                "text": "Format-string vulnerability"
              },
              "fullDescription": {
                "text": "A non-constant format string lets input read or write memory through %n / %s specifiers."
              },
              "help": {
                "text": "Use a constant format: printf(\"%s\", input)."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-134",
                  "A03:2021 Injection"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CM-SQL-002",
              "name": "NoSQL / query operator injection",
              "shortDescription": {
                "text": "NoSQL / query operator injection"
              },
              "fullDescription": {
                "text": "Request objects are passed directly to a database query, allowing operator injection ($ne, $gt, $where)."
              },
              "help": {
                "text": "Validate and cast types explicitly; reject objects where scalars are expected."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-943",
                  "A03:2021 Injection"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CM-INJ-003",
              "name": "Code injection via eval/exec",
              "shortDescription": {
                "text": "Code injection via eval/exec"
              },
              "fullDescription": {
                "text": "Dynamic evaluation of strings can execute attacker-controlled code."
              },
              "help": {
                "text": "Remove eval/exec; use ast.literal_eval or JSON parsing for data."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-95",
                  "A03:2021 Injection"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CM-AUTH-001",
              "name": "JWT signature not verified / 'none' allowed",
              "shortDescription": {
                "text": "JWT signature not verified / 'none' allowed"
              },
              "fullDescription": {
                "text": "Tokens are accepted without cryptographic verification, letting anyone forge identities."
              },
              "help": {
                "text": "Always verify signature, pin algorithms and enforce expiry."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-347",
                  "A07:2021 Identification and Authentication Failures"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "CM-CRY-001",
              "name": "Weak hash algorithm (MD5/SHA-1)",
              "shortDescription": {
                "text": "Weak hash algorithm (MD5/SHA-1)"
              },
              "fullDescription": {
                "text": "MD5/SHA-1 are collision-prone and unsuitable for security purposes such as password storage."
              },
              "help": {
                "text": "Use SHA-256+ for integrity and Argon2/bcrypt/scrypt for passwords."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-328",
                  "A02:2021 Cryptographic Failures"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "CM-AUTH-002",
              "name": "Redirect to user-controlled URL",
              "shortDescription": {
                "text": "Redirect to user-controlled URL"
              },
              "fullDescription": {
                "text": "Unvalidated redirect targets enable phishing via trusted domains."
              },
              "help": {
                "text": "Allow only relative paths or an allow-list of hosts."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-601",
                  "A01:2021 Broken Access Control"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "CM-CRY-003",
              "name": "Insecure randomness for security token",
              "shortDescription": {
                "text": "Insecure randomness for security token"
              },
              "fullDescription": {
                "text": "A predictable PRNG generates a value that must be unguessable."
              },
              "help": {
                "text": "Use secrets.token_urlsafe / crypto.randomBytes / SecureRandom / crypto/rand."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-338",
                  "A02:2021 Cryptographic Failures"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "CM-NET-003",
              "name": "Debug mode / wildcard CORS enabled",
              "shortDescription": {
                "text": "Debug mode / wildcard CORS enabled"
              },
              "fullDescription": {
                "text": "Debug consoles or permissive CORS expose internals and authenticated endpoints to any origin."
              },
              "help": {
                "text": "Disable debug in production; restrict CORS to known origins."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-489",
                  "A05:2021 Security Misconfiguration"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "CM-CFG-001",
              "name": "Container / infra runs privileged or as root",
              "shortDescription": {
                "text": "Container / infra runs privileged or as root"
              },
              "fullDescription": {
                "text": "Over-privileged workload or world-open network rule increases blast radius."
              },
              "help": {
                "text": "Drop privileges, set runAsNonRoot and restrict CIDR ranges."
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-250",
                  "A05:2021 Security Misconfiguration"
                ],
                "security-severity": "5.5"
              }
            }
          ]
        }
      },
