# Copy to codemender_agent/.env (git-ignored) before deploying. `adk deploy agent_engine` reads this file:
# GOOGLE_CLOUD_PROJECT, GOOGLE_CLOUD_LOCATION and GOOGLE_CLOUD_SERVICE_ACCOUNT configure the deployment itself;
# every other variable here (for example CODEMENDER_MODEL) is passed to the running agent.
GOOGLE_CLOUD_PROJECT=gebu-demo-sandbox
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_SERVICE_ACCOUNT=app-svc-custom-sandbox@gebu-demo-sandbox.iam.gserviceaccount.com
CODEMENDER_MODEL=gemini-2.5-flash
