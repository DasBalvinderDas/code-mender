# Copy to .env (git-ignored) in the repository root. Used by deploy/*.py. Do NOT put a .env inside codemender_agent/:
# `adk deploy` would read it and override these settings.
GOOGLE_CLOUD_PROJECT=gebu-demo-sandbox
GOOGLE_CLOUD_LOCATION=us-central1
# Identity the deployed agent runs as; needs roles/aiplatform.user. Empty = Agent Engine's default service agent.
AGENT_SERVICE_ACCOUNT=app-svc-custom-sandbox@gebu-demo-sandbox.iam.gserviceaccount.com
# Gemini model the agent uses (pick one available in your project)
CODEMENDER_MODEL=gemini-2.5-flash
# URL of the CodeMender runner (Cloud Run). Written by deploy/deploy_runner.sh. Empty = the agent only has the built-in quick scan.
CODEMENDER_RUNNER_URL=
# Written by deploy/deploy_agent_engine.py after deployment:
# AGENT_ENGINE_RESOURCE=projects/<project-number>/locations/us-central1/reasoningEngines/<id>
